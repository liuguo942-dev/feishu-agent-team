{
  "agents": {
    "defaults": {
      "workspace": "${OPENCLAW_WORKSPACE}/workspace",
      "model": {
        "primary": "deepseek/deepseek-v4-flash"
      }
    },
    "list": [
      {
        "id": "客服调度",
        "name": "客服调度员",
        "default": true,
        "workspace": "${OPENCLAW_WORKSPACE}/agents/客服调度/workspace",
        "model": {
          "primary": "deepseek/deepseek-v4-flash"
        },
        "tools": {
          "profile": "coding",
          "allow": [
            "sessions_spawn",
            "sessions_send",
            "sessions_list",
            "sessions_history",
            "sessions_yield",
            "read"
          ]
        }
      },
      {
        "id": "信息采集",
        "name": "信息采集员",
        "workspace": "${OPENCLAW_WORKSPACE}/agents/信息采集/workspace",
        "model": {
          "primary": "deepseek/deepseek-v4-flash"
        },
        "tools": {
          "profile": "coding",
          "allow": [
            "web_search",
            "bash",
            "read",
            "write"
          ]
        }
      },
      {
        "id": "工单处理",
        "name": "工单处理员",
        "workspace": "${OPENCLAW_WORKSPACE}/agents/工单处理/workspace",
        "model": {
          "primary": "deepseek/deepseek-v4-flash"
        },
        "tools": {
          "profile": "coding",
          "allow": [
            "read",
            "write"
          ]
        }
      }
    ]
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "<YOUR_GATEWAY_TOKEN>"
    },
    "port": 18789,
    "bind": "loopback"
  },
  "tools": {
    "profile": "coding",
    "web": {
      "search": {
        "provider": "duckduckgo",
        "enabled": true
      }
    },
    "agentToAgent": {
      "enabled": true,
      "allow": ["客服调度", "信息采集", "工单处理"]
    }
  },
  "bindings": [
    {
      "agentId": "客服调度",
      "match": {
        "channel": "clickclack",
        "accountId": "default"
      }
    }
  ],
  "models": {
    "providers": {
      "deepseek": {
        "baseUrl": "https://api.deepseek.com",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-v4-flash",
            "name": "DeepSeek V4 Flash",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 1000000,
            "maxTokens": 384000,
            "api": "openai-completions"
          }
        ]
      }
    }
  },
  "auth": {
    "profiles": {
      "deepseek:default": {
        "provider": "deepseek",
        "mode": "api_key"
      }
    }
  },
  "channels": {
    "clickclack": {
      "enabled": true
    }
  }
}
